:root { color: rgb(222, 233, 237); -unity-font-style: normal; font-size: 13px; }
#title { position: absolute; left: 28px; top: 25px; }
#eyebrow { color: rgb(94, 209, 190); font-size: 11px; letter-spacing: 2px; }
#headline { font-size: 30px; -unity-font-style: bold; margin-top: 7px; }
#subtitle { font-size: 10px; color: rgb(141, 158, 169); margin-top: 5px; }
#sidebar { position: absolute; right: 22px; top: 24px; width: 270px; bottom: 116px; padding: 18px; background-color: rgba(16, 28, 38, .94); border-radius: 12px; border-width: 1px; border-color: rgb(48, 68, 80); }
#panel-title { font-size: 11px; color: rgb(143, 165, 177); letter-spacing: 1px; margin-bottom: 16px; }
.state { color: rgb(112, 224, 204); font-size: 18px; -unity-font-style: bold; margin-bottom: 16px; white-space: normal; }
.metric { color: rgb(186, 206, 217); white-space: normal; font-size: 12px; margin-bottom: 14px; }
#lab-title { margin-top: 8px; font-size: 11px; -unity-font-style: bold; color: rgb(151, 176, 191); }
#description { margin-top: 7px; margin-bottom: 15px; white-space: normal; font-size: 11px; color: rgb(142, 163, 176); }
Button { background-color: rgb(38, 60, 72); color: rgb(228, 239, 242); border-color: rgb(62, 88, 99); border-width: 1px; border-radius: 6px; padding-top: 10px; padding-bottom: 10px; padding-left: 10px; padding-right: 10px; margin-bottom: 8px; }
Button:hover { background-color: rgb(46, 94, 102); border-color: rgb(92, 206, 185); }
Button:active { background-color: rgb(45, 128, 128); }
#actions { position: absolute; bottom: 26px; left: 28px; right: 24px; flex-direction: row; justify-content: space-between; }
#actions Button { flex-grow: 1; margin-right: 8px; padding-top: 15px; padding-bottom: 15px; font-size: 13px; }
#camera-hint { position: absolute; left: 30px; bottom: 91px; font-size: 10px; color: rgb(140, 163, 176); }
#debug-panel { flex-grow: 1; min-height: 80px; }
.diagnostics { white-space: normal; font-size: 10px; color: rgb(170, 194, 203); }
#servo-note { white-space: normal; color: rgb(232, 190, 119); font-size: 10px; margin-bottom: 8px; }
#servo-panel { margin-bottom: 12px; }
#servo-panel Slider { margin-top: 8px; }
#servo-panel .servo-slider { flex-direction: column; }
#servo-panel .servo-slider .unity-base-field__label { min-width: 0; width: auto; font-size: 10px; margin-bottom: 3px; }
#servo-panel .unity-base-field__input { background-color: rgb(25, 43, 55); color: rgb(220, 239, 240); }
#servo-panel .unity-base-text-field__input { background-color: rgb(34, 57, 69); color: rgb(220, 239, 240); border-color: rgb(62, 88, 99); border-width: 1px; }
#servo-panel .unity-base-slider__input { min-width: 120px; min-height: 18px; height: 18px; }
#servo-panel .servo-side .unity-base-field__label { min-width: 30px; width: 40px; }
#servo-panel .unity-popup-field__text { color: rgb(220, 239, 240); }
#servo-panel .unity-base-slider__tracker { height: 3px; background-color: rgb(64, 104, 117); }
#servo-panel .unity-base-slider__dragger { width: 10px; background-color: rgb(94, 209, 190); border-radius: 4px; }
#sidebar .unity-scroller { width: 7px; background-color: rgb(22, 37, 47); }
#sidebar .unity-scroller__low-button, #sidebar .unity-scroller__high-button { display: none; }
#sidebar .unity-scroller .unity-base-slider__tracker { background-color: rgb(22, 37, 47); }
#sidebar .unity-scroller .unity-base-slider__dragger { background-color: rgb(64, 104, 117); border-radius: 3px; }
