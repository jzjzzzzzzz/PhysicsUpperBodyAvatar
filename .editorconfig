root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,py,sh}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,asmdef}]
indent_style = space
indent_size = 2

[*.csv]
charset = utf-8-bom
end_of_line = crlf

[*.{unity,prefab,asset,meta}]
trim_trailing_whitespace = false
