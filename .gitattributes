* text=auto
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.uss text eol=lf
*.tss text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.fbx binary
*.tga binary
*.png binary
*.jpg binary
*.jpeg binary

# Unity writes empty YAML fields with a trailing space. Keep engine formatting.
*.unity whitespace=-blank-at-eol
*.prefab whitespace=-blank-at-eol
*.asset whitespace=-blank-at-eol
*.csv text eol=crlf

*.meta whitespace=-blank-at-eol
